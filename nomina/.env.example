# Copie este archivo a .env o, mejor, genere uno con llaves nuevas:
#     python generar_env.py            (SQLite, desarrollo)
#     python generar_env.py --postgres (PostgreSQL)
# NUNCA suba el .env a git. Guarde una copia de las llaves fuera del servidor.

# desarrollo | produccion
NOMINA_ENTORNO=desarrollo
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambie-esto
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# ej. https://nomina.midominio.com (producción)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Cifrado AES-256 (32 bytes en base64). Varias llaves = rotación.
NOMINA_LLAVES_CIFRADO=1:REEMPLAZAR_CON_LLAVE_BASE64
NOMINA_LLAVE_ACTIVA=1
NOMINA_LLAVE_INDICE=REEMPLAZAR_CON_LLAVE_BASE64

# Base de datos
# postgres | sqlite (solo desarrollo)
NOMINA_DB_MOTOR=postgres
POSTGRES_DB=nomina
POSTGRES_USER=nomina
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seguridad (valores por defecto mostrados)
NOMINA_MINUTOS_SESION=15
NOMINA_INTENTOS_MAXIMOS=5
# vacío = bloqueado hasta que un administrador desbloquee
NOMINA_MINUTOS_BLOQUEO=
# 1 si hay un proxy (Caddy/nginx) delante
NOMINA_PROXIES_CONFIABLES=0
