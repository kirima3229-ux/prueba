# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Credenciales OAuth de Google Cloud Console
# (APIs y servicios -> Credenciales -> Crear ID de cliente de OAuth -> Aplicacion web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el "URI de redireccionamiento autorizado"
# configurado en Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Secreto para firmar la cookie de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Puerto del servidor
PORT=3000

# Pon "true" si sirves la app detras de HTTPS (activa cookies Secure)
SECURE_COOKIES=false
